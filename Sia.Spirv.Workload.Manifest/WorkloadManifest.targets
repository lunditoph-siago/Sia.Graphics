<Project>
  <PropertyGroup>
    <_SiaSpirvWorkloadSdkDirectory>$(NetCoreRoot)packs\Sia.Spirv.Sdk\0.1.0-preview.1\Sdk</_SiaSpirvWorkloadSdkDirectory>
    <_SiaSpirvUseWorkloadIntegration Condition="'$(EnableSpirvCompilation)' == 'true' and '$(SiaSpirvDisableWorkloadIntegration)' != 'true' and Exists('$(_SiaSpirvWorkloadSdkDirectory)\Sdk.props')">true</_SiaSpirvUseWorkloadIntegration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SiaSpirvUseWorkloadIntegration)' == 'true'">
    <SiaSpirvSkipMicrosoftNetSdkTargetsImport>true</SiaSpirvSkipMicrosoftNetSdkTargetsImport>
  </PropertyGroup>
  <Import Project="Sia.Spirv.Integration.props"
          Sdk="Sia.Spirv.Sdk"
          Condition="'$(_SiaSpirvUseWorkloadIntegration)' == 'true'" />
  <Import Project="Sdk.targets"
          Sdk="Sia.Spirv.Sdk"
          Condition="'$(_SiaSpirvUseWorkloadIntegration)' == 'true'" />
</Project>
