<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup Condition="'$(SiaShaderAssetFormat)' == '' And '$(_SiaWebGpuSiteRootPublishDir)' == ''">
    <_SiaWebGpuSiteRootPublishDir>$(PublishDir)</_SiaWebGpuSiteRootPublishDir>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmBuildNative>true</WasmBuildNative>
    <EmccExtraLDFlags>-sALLOW_MEMORY_GROWTH</EmccExtraLDFlags>
    <SiaShaderAssetFormat Condition="'$(SiaShaderAssetFormat)' == ''">Wgsl</SiaShaderAssetFormat>
    <EnableSpirvCompilation Condition="'$(SiaShaderAssetFormat)' == 'Wgsl'">false</EnableSpirvCompilation>
    <EnableSpirvCompilation Condition="'$(SiaShaderAssetFormat)' == 'Spirv'">true</EnableSpirvCompilation>
    <DefineConstants Condition="'$(SiaShaderAssetFormat)' == 'Spirv'">$(DefineConstants);SIA_SPIRV_ASSETS</DefineConstants>
    <SpirvTargetEnvironment>vulkan1.2</SpirvTargetEnvironment>
    <SpirvKernelAbi>webgpu</SpirvKernelAbi>
    <SpirvEmitWgsl>true</SpirvEmitWgsl>
    <SpirvOptimizationLevel>3</SpirvOptimizationLevel>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(SiaShaderAssetFormat)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj_desktop\**;publish\**" />
    <EmbeddedResource Remove="obj_desktop\**;publish\**" />
    <None Remove="obj_desktop\**;publish\**" />
    <Content Remove="obj_desktop\**;publish\**" />
  </ItemGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sia.Graphics\Sia.Graphics.csproj" />
    <ProjectReference Include="..\Sia.Spirv.Core\Sia.Spirv.Core.csproj" />
    <ProjectReference Include="..\Sia.WebGPU\Sia.WebGPU.csproj" />
    <PackageReference Include="Sia.Window" Version="0.0.4" />
    <PackageReference Include="Sia.UI" Version="0.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\*.ttf">
      <LogicalName>Sia.WebGPU.Example.Fonts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="RemoveBundledSpirvCoreReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="Sia.Spirv.Core" />
    </ItemGroup>
  </Target>

  <Import Project="..\Sia.WebGPU.Native\build\net461\Sia.WebGPU.Native.targets" />

  <Target Name="AssembleSiaWebGpuSite"
          AfterTargets="Publish"
          Condition="'$(_SiaWebGpuSiteRootPublishDir)' != ''">
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);SiaShaderAssetFormat=Wgsl;PublishDir=$(_SiaWebGpuSiteRootPublishDir)dawn-wgsl\" />
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);SiaShaderAssetFormat=Spirv;PublishDir=$(_SiaWebGpuSiteRootPublishDir)dawn-spirv\" />

    <RemoveDir Directories="$(_SiaWebGpuSiteRootPublishDir)wwwroot"
               Condition="Exists('$(_SiaWebGpuSiteRootPublishDir)wwwroot')" />
    <ItemGroup>
      <_SiaWebGpuSiteStrayFile Include="$(_SiaWebGpuSiteRootPublishDir)*.js;$(_SiaWebGpuSiteRootPublishDir)*.json;$(_SiaWebGpuSiteRootPublishDir)web.config" />
      <_SiaWebGpuLauncherFile Include="index.html" />
    </ItemGroup>
    <Delete Files="@(_SiaWebGpuSiteStrayFile)" />
    <Copy SourceFiles="@(_SiaWebGpuLauncherFile)" DestinationFolder="$(_SiaWebGpuSiteRootPublishDir)%(RecursiveDir)" />
  </Target>

  <Import Project="..\Sia.Graphics\Sia.Graphics.targets" />
</Project>
