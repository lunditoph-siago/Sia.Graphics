<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.Graphics</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Compatibility/Catalog/gpu-capabilities.json" />
    <None Remove="Sia.Graphics.targets;Presentation\Browser\Canvas.c;Presentation\Browser\Canvas.library.js" />
    <None Include="Sia.Graphics.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="Presentation\Browser\Canvas.c;Presentation\Browser\Canvas.library.js" Pack="true" PackagePath="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sia.RenderGraph\Sia.RenderGraph.csproj" />
    <ProjectReference Include="..\Sia.WebGPU\Sia.WebGPU.csproj" />
    <PackageReference Include="Sia.Input" Version="0.0.4" />
    <PackageReference Include="Sia.Prelude" Version="2.1.3" />
    <PackageReference Include="Sia.Math" Version="0.0.3" />
    <PackageReference Include="Sia.CodeGenerators" Version="2.1.3" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
