<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.Spirv.Toolchain.win-x64</PackageId>
    <PackageDescription>Prebuilt LLVM 23 and SPIRV-Tools host toolchain for Windows x64.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <_RequiredSpirvTool Include="llc.exe;opt.exe;llvm-as.exe;llvm-dis.exe;spirv-as.exe;spirv-dis.exe;spirv-link.exe;spirv-opt.exe;spirv-val.exe" />
    <_RequiredSpirvLicense Include="LLVM.txt;SPIRV-Tools.txt;SPIRV-Headers.txt" />
    <None Include="ToolchainManifest.json" Pack="true" PackagePath="metadata" />
    <None Include="Sdk\**\*" Pack="true" PackagePath="Sdk" />
    <None Include="buildTransitive\**\*" Pack="true" PackagePath="buildTransitive" />
    <None Include="@(_RequiredSpirvTool->'..\artifacts\llvm-toolchain\bin\%(Identity)')"
          Pack="true"
          PackagePath="tools\win-x64" />
    <None Include="@(_RequiredSpirvLicense->'..\artifacts\llvm-toolchain\licenses\%(Identity)')"
          Pack="true"
          PackagePath="licenses" />
  </ItemGroup>

  <Target Name="ValidateSpirvToolchainPackInputs" BeforeTargets="Pack">
    <Error Condition="!Exists('..\artifacts\llvm-toolchain\bin\%(_RequiredSpirvTool.Identity)')"
           Text="Required prebuilt tool '%(_RequiredSpirvTool.Identity)' was not found. Build the native toolchain first." />
    <Error Condition="!Exists('..\artifacts\llvm-toolchain\licenses\%(_RequiredSpirvLicense.Identity)')"
           Text="Required native license '%(_RequiredSpirvLicense.Identity)' was not staged. Build the native toolchain first." />
  </Target>
</Project>
