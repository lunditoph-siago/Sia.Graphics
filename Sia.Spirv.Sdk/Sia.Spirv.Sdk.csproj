<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Sia.Spirv.Sdk</PackageId>
    <PackageDescription>MSBuild SDK for C# GPU compilation with LLVM and the managed Sia shader translator.</PackageDescription>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectSpirvSdkTools</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sia.Spirv.Tool\Sia.Spirv.Tool.csproj"
                      ReferenceOutputAssembly="false" />
    <None Include="Sdk\**\*" Pack="true" PackagePath="Sdk" />
    <None Include="buildTransitive\**\*" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <Target Name="CollectSpirvSdkTools" DependsOnTargets="Build">
    <MSBuild Projects="@(ProjectReference)"
             Targets="PublishItemsOutputGroup"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_SpirvSdkToolFile" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_SpirvSdkToolFile)"
                              PackagePath="tools/$(TargetFramework)/%(_SpirvSdkToolFile.TargetPath)" />
    </ItemGroup>
  </Target>
</Project>
