<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-spirv</ToolCommandName>
    <PackageId>Sia.Spirv.Bootstrap</PackageId>
    <PackageDescription>Bootstraps and installs the Sia LLVM SPIR-V workload for a .NET SDK.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SiaSpirvPackageVersion" Value="$(PackageVersion)" />
    <EmbeddedResource Include="..\Sia.Spirv.Workload.Manifest\WorkloadManifest.targets"
                      Link="WorkloadManifest.targets"
                      LogicalName="Sia.Spirv.Bootstrap.WorkloadManifest.targets" />
  </ItemGroup>
</Project>
