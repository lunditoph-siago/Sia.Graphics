<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Sia.Spirv.Sdk</PackageId>
    <PackageDescription>MSBuild SDK for C# GPU compilation with LLVM and the managed Sia shader translator.</PackageDescription>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectSpirvSdkTools</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sia.Spirv.Tool\Sia.Spirv.Tool.csproj"
                      ReferenceOutputAssembly="false" />
    <None Include="Sdk\**\*" Pack="true" PackagePath="Sdk" />
    <None Include="buildTransitive\**\*" Pack="true" PackagePath="buildTransitive" />
    <None Include="..\Sia.Spirv.Compiler\Translation\Naga.LICENSE.txt" Pack="true" PackagePath="licenses" />
  </ItemGroup>

  <Target Name="BuildSpirvCompilerBrowser">
    <PropertyGroup>
      <_SpirvBrowserOutputDirectory>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)compiler-browser'))</_SpirvBrowserOutputDirectory>
    </PropertyGroup>
    <!-- Fingerprinted Wasm assets from previous publishes must not enter a new package. -->
    <RemoveDir Directories="$(_SpirvBrowserOutputDirectory)" />
    <MSBuild Projects="..\Sia.Spirv.Compiler.Browser\Sia.Spirv.Compiler.Browser.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_SpirvBrowserOutputDirectory)\" />
  </Target>

  <Target Name="CollectSpirvSdkTools" DependsOnTargets="Build;BuildSpirvCompilerBrowser">
    <ItemGroup>
      <TfmSpecificPackageFile Include="..\Sia.Spirv.Tool\bin\$(Configuration)\net11.0\**\*">
        <PackagePath>tools/net11.0</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(_SpirvBrowserOutputDirectory)\wwwroot\**\*">
        <PackagePath>tools/browser</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="..\Sia.Spirv.Compiler.Browser\sia-spirv-polyfill.js">
        <PackagePath>tools/browser</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
