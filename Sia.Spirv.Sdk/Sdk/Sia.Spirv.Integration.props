<Project>
  <PropertyGroup>
    <EnableSpirvCompilation Condition="'$(EnableSpirvCompilation)' == ''">true</EnableSpirvCompilation>
    <SpirvTargetEnvironment Condition="'$(SpirvTargetEnvironment)' == ''">vulkan1.2</SpirvTargetEnvironment>
    <SpirvOptimizationLevel Condition="'$(SpirvOptimizationLevel)' == ''">2</SpirvOptimizationLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Sia.Spirv.Core">
      <HintPath>$(MSBuildThisFileDirectory)..\tools\net11.0\Sia.Spirv.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSpirvRuntimeCompilation)' == 'true'">
    <Reference Include="Sia.Spirv.Compiler">
      <HintPath>$(MSBuildThisFileDirectory)..\tools\net11.0\Sia.Spirv.Compiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Sia.Spirv.Runtime">
      <HintPath>$(MSBuildThisFileDirectory)..\tools\net11.0\Sia.Spirv.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
