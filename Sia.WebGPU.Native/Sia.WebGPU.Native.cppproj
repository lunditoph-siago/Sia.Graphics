<Project DefaultTargets="Build">
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <PackageId>Sia.WebGPU.Native</PackageId>
    <Description>Native WebGPU libraries for desktop platforms.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lunditoph-siago/Sia.Graphics</RepositoryUrl>
    <NativeRuntimeIdentifiers Condition="'$(NativeRuntimeIdentifiers)' == ''">win-x86;win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</NativeRuntimeIdentifiers>
    <NativeRuntimeDirectory Condition="'$(NativeRuntimeDirectory)' == ''">$(MSBuildProjectDirectory)/../artifacts/webgpu-runtimes</NativeRuntimeDirectory>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectNativeBinaries</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="_._" PackagePath="lib/net11.0" />
    <None Include="LICENSE.webgpu" Pack="true" PackagePath="" />
    <None Include="NativeBuildTask.cs" Pack="true" PackagePath="buildTransitive" />
    <None Include="$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/wgpu_native.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Link="%(Filename)%(Extension)" Pack="false" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/dxcompiler.dll;$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/dxil.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Link="%(Filename)%(Extension)" Pack="false" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/libwgpu_native.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))"
          Link="%(Filename)%(Extension)" Pack="false" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/libwgpu_native.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Link="%(Filename)%(Extension)" Pack="false" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CollectNativeBinaries">
    <PrepareWebGpuTask HeaderDirectory="$(MSBuildProjectDirectory)/../Sia.WebGPU.Generators/Resources" ArtifactsDirectory="$(NativeArtifactsDirectory)" ReleaseTag="$(WebGpuRelease)">
      <Output TaskParameter="Revision" PropertyName="NativeRevision" />
      <Output TaskParameter="HeaderRoot" PropertyName="NativeHeaderRoot" />
    </PrepareWebGpuTask>
    <PropertyGroup>
      <_NativePackageTargets>$(IntermediateOutputPath)Sia.WebGPU.Native.targets</_NativePackageTargets>
      <_NativePackageContent><![CDATA[<Project>
  <PropertyGroup>
    <SiaNativeBuildTaskSource>%24(MSBuildThisFileDirectory)NativeBuildTask.cs</SiaNativeBuildTaskSource>
    <SiaWebGpuIncludeDirectory>%24(MSBuildThisFileDirectory)../include</SiaWebGpuIncludeDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'%24(MSBuildProjectExtension)' == '.cppproj'">
    <NativeIncludeDirectory Include="%24(SiaWebGpuIncludeDirectory)" />
    <NativeLibrary Include="%24(MSBuildThisFileDirectory)../build/native/lib/%24(RuntimeIdentifier)/wgpu_native.lib" Condition="%24([System.String]::Copy('%24(RuntimeIdentifier)').StartsWith('win-'))" />
    <NativeLibrary Include="%24(MSBuildThisFileDirectory)../runtimes/%24(RuntimeIdentifier)/native/libwgpu_native.so" Condition="%24([System.String]::Copy('%24(RuntimeIdentifier)').StartsWith('linux-'))" />
    <NativeLibrary Include="%24(MSBuildThisFileDirectory)../runtimes/%24(RuntimeIdentifier)/native/libwgpu_native.dylib" Condition="%24([System.String]::Copy('%24(RuntimeIdentifier)').StartsWith('osx-'))" />
  </ItemGroup>
</Project>]]></_NativePackageContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_NativePackageTargets)" Lines="$(_NativePackageContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <_NativeRuntime Include="$(NativeRuntimeIdentifiers)" />
      <_NativeRuntime Update="@(_NativeRuntime)">
        <Library Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('win-'))">wgpu_native.dll</Library>
        <Library Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('linux-'))">libwgpu_native.so</Library>
        <Library Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('osx-'))">libwgpu_native.dylib</Library>
      </_NativeRuntime>
    </ItemGroup>
    <Error Condition="'%(_NativeRuntime.Library)' == ''" Text="Unsupported native runtime %(_NativeRuntime.Identity)." />
    <Error Condition="!Exists('$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/%(_NativeRuntime.Library)')"
           Text="Run dotnet build Sia.WebGPU.Native/Sia.WebGPU.Native.cppproj -r %(_NativeRuntime.Identity) before packing." />
    <Error Condition="!Exists('$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/native-release.txt')"
           Text="Missing WebGPU native release receipt for %(_NativeRuntime.Identity)." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/native-release.txt').Trim()) != '$(NativeRevision)'"
           Text="WebGPU native release mismatch for %(_NativeRuntime.Identity); rebuild before packing." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_NativePackageTargets)" PackagePath="buildTransitive/Sia.WebGPU.Native.targets" />
      <TfmSpecificPackageFile Include="$(NativeHeaderRoot)/include/webgpu/webgpu.h" PackagePath="include/webgpu/webgpu.h" />
      <TfmSpecificPackageFile Include="$(NativeHeaderRoot)/include/dawn/webgpu.h" PackagePath="include/dawn/webgpu.h" />
      <TfmSpecificPackageFile Include="$(NativeHeaderRoot)/include/dawn/dawn_version.h" PackagePath="include/dawn/dawn_version.h" />
      <TfmSpecificPackageFile Include="$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/%(_NativeRuntime.Library)"
                              PackagePath="runtimes/%(_NativeRuntime.Identity)/native/%(_NativeRuntime.Library)" />
      <TfmSpecificPackageFile Include="$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/dxc*;$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/dxil.dll;$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/LICENSE.dxc"
                              Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('win-'))"
                              PackagePath="runtimes/%(_NativeRuntime.Identity)/native/" />
      <TfmSpecificPackageFile Include="$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/wgpu_native.lib"
                              Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('win-'))"
                              PackagePath="build/native/lib/%(_NativeRuntime.Identity)/wgpu_native.lib" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(TfmSpecificPackageFile)"><Output TaskParameter="Filtered" ItemName="_NativePackageFiles" /></RemoveDuplicates>
    <ItemGroup><TfmSpecificPackageFile Remove="@(TfmSpecificPackageFile)" /><TfmSpecificPackageFile Include="@(_NativePackageFiles)" /></ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="Native.targets" />
</Project>
