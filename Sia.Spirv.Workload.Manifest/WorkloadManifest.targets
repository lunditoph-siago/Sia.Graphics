<Project>
  <PropertyGroup Condition="'$(EnableSpirvCompilation)' == 'true' and '$(SiaSpirvDisableWorkloadIntegration)' != 'true'">
    <SiaSpirvSkipMicrosoftNetSdkTargetsImport>true</SiaSpirvSkipMicrosoftNetSdkTargetsImport>
  </PropertyGroup>
  <Import Project="Sia.Spirv.Integration.props"
          Sdk="Sia.Spirv.Sdk"
          Condition="'$(EnableSpirvCompilation)' == 'true' and '$(SiaSpirvDisableWorkloadIntegration)' != 'true'" />
  <Import Project="Sdk.targets"
          Sdk="Sia.Spirv.Sdk"
          Condition="'$(EnableSpirvCompilation)' == 'true' and '$(SiaSpirvDisableWorkloadIntegration)' != 'true'" />
</Project>
