<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.WebGPU</PackageId>
    <PackageDescription>Generated WebGPU bindings with first-class Sia ECS resource integration.</PackageDescription>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sia.RenderGraph\Sia.RenderGraph.csproj" />
    <ProjectReference Include="..\Sia.WebGPU.Generators\Sia.WebGPU.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <PackageReference Include="Sia" Version="2.1.5" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-browser'">
    <DefineConstants Condition="'$(SiaWebGpuBackend)' == 'Dawn' Or '$(SiaWebGpuBackend)' == ''">$(DefineConstants);SIA_WEBGPU_BACKEND_DAWN</DefineConstants>
    <DefineConstants Condition="'$(SiaWebGpuBackend)' == 'Wgpu'">$(DefineConstants);SIA_WEBGPU_BACKEND_WGPU</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-browser' And ('$(SiaWebGpuBackend)' == 'Dawn' Or '$(SiaWebGpuBackend)' == '')">
    <ProjectReference Include="..\Sia.Spirv.Compiler\Sia.Spirv.Compiler.csproj" />
  </ItemGroup>

</Project>
