<Project DefaultTargets="Build">
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <PackageId>Sia.WebGPU.Native</PackageId>
    <Description>Native WebGPU libraries for desktop platforms.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lunditoph-siago/Sia.Graphics</RepositoryUrl>
    <NativeRuntimeIdentifiers Condition="'$(NativeRuntimeIdentifiers)' == ''">win-x86;win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</NativeRuntimeIdentifiers>
    <NativeRuntimeDirectory Condition="'$(NativeRuntimeDirectory)' == ''">$(MSBuildProjectDirectory)/../artifacts/webgpu-runtimes</NativeRuntimeDirectory>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectNativeBinaries</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="_._" PackagePath="lib/net11.0" />
    <None Include="LICENSE.webgpu" Pack="true" PackagePath="" />
    <None Include="Sia.WebGPU.Native.targets;NativeBuildTask.cs" Pack="true" PackagePath="buildTransitive" />
    <None Include="$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/wgpu_native.dll"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))" Link="%(Filename)%(Extension)" Pack="false"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/dxcompiler.dll;
                   $(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/dxil.dll"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))" Link="%(Filename)%(Extension)" Pack="false"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/libwgpu_native.so"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))" Link="%(Filename)%(Extension)" Pack="false"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native/libwgpu_native.dylib"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))" Link="%(Filename)%(Extension)" Pack="false"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CollectNativeBinaries">
    <PrepareWebGpuTask HeaderDirectory="$(MSBuildProjectDirectory)/../Sia.WebGPU.Generators/Resources"
                       ArtifactsDirectory="$(NativeArtifactsDirectory)" ReleaseTag="$(WebGpuRelease)">
      <Output TaskParameter="Revision" PropertyName="NativeRevision" />
      <Output TaskParameter="HeaderRoot" PropertyName="NativeHeaderRoot" />
    </PrepareWebGpuTask>
    <ItemGroup>
      <_NativeRuntime Include="$(NativeRuntimeIdentifiers)" />
      <_NativeRuntime Update="@(_NativeRuntime)">
        <Library Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('win-'))">wgpu_native.dll</Library>
        <Library Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('linux-'))">libwgpu_native.so</Library>
        <Library Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('osx-'))">libwgpu_native.dylib</Library>
      </_NativeRuntime>
    </ItemGroup>
    <Error Condition="'%(_NativeRuntime.Library)' == ''"
           Text="Unsupported native runtime %(_NativeRuntime.Identity)." />
    <Error Condition="!Exists('$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/%(_NativeRuntime.Library)')"
           Text="Run dotnet build Sia.WebGPU.Native/Sia.WebGPU.Native.cppproj -r %(_NativeRuntime.Identity) before packing." />
    <Error Condition="!Exists('$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/native-release.txt')"
           Text="Missing WebGPU native release receipt for %(_NativeRuntime.Identity)." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/native-release.txt').Trim()) != '$(NativeRevision)'"
           Text="WebGPU native release mismatch for %(_NativeRuntime.Identity); rebuild before packing." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(NativeHeaderRoot)/include/webgpu/webgpu.h"
                              PackagePath="include/webgpu/webgpu.h" />
      <TfmSpecificPackageFile Include="$(NativeHeaderRoot)/include/dawn/webgpu.h" PackagePath="include/dawn/webgpu.h" />
      <TfmSpecificPackageFile Include="$(NativeHeaderRoot)/include/dawn/dawn_version.h"
                              PackagePath="include/dawn/dawn_version.h" />
      <TfmSpecificPackageFile Include="$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/%(_NativeRuntime.Library)"
                              PackagePath="runtimes/%(_NativeRuntime.Identity)/native/%(_NativeRuntime.Library)" />
      <TfmSpecificPackageFile Include="$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/dxc*;
                                       $(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/dxil.dll;
                                       $(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/LICENSE.dxc"
                              Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('win-'))"
                              PackagePath="runtimes/%(_NativeRuntime.Identity)/native/" />
      <TfmSpecificPackageFile Include="$(NativeRuntimeDirectory)/%(_NativeRuntime.Identity)/native/wgpu_native.lib"
                              Condition="$([System.String]::Copy('%(_NativeRuntime.Identity)').StartsWith('win-'))"
                              PackagePath="build/native/lib/%(_NativeRuntime.Identity)/wgpu_native.lib" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(TfmSpecificPackageFile)">
      <Output TaskParameter="Filtered" ItemName="_NativePackageFiles" />
    </RemoveDuplicates>
    <ItemGroup>
      <TfmSpecificPackageFile Remove="@(TfmSpecificPackageFile)" />
      <TfmSpecificPackageFile Include="@(_NativePackageFiles)" />
    </ItemGroup>
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Import Project="NativeTasks.targets" />

  <PropertyGroup>
    <NativeIntermediateDirectory Condition="'$(NativeIntermediateDirectory)' == ''">$(MSBuildProjectDirectory)/obj/native/$(RuntimeIdentifier)/$(Configuration)</NativeIntermediateDirectory>
    <NativeOutputDirectory Condition="'$(NativeOutputDirectory)' == ''">$(NativeRuntimeDirectory)/$(RuntimeIdentifier)/native</NativeOutputDirectory>
    <NativeOutputFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(NativeOutputDirectory)/wgpu_native.dll</NativeOutputFile>
    <NativeOutputFile Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(NativeOutputDirectory)/libwgpu_native.so</NativeOutputFile>
    <NativeOutputFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(NativeOutputDirectory)/libwgpu_native.dylib</NativeOutputFile>
    <NativeMaxParallelism Condition="'$(NativeMaxParallelism)' == ''">2</NativeMaxParallelism>
  </PropertyGroup>

  <UsingTask TaskName="NativeBuildTask" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)NativeBuildTask.cs" />
    </Task>
  </UsingTask>

  <Target Name="PrepareNative">
    <Error Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' != '$(NETCoreSdkRuntimeIdentifier)'"
           Text="This native target requires a matching host SDK/toolchain; cross-platform builds do not automatically cross-compile." />
    <Error Condition="$([MSBuild]::IsOSPlatform('Windows')) And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))"
           Text="Windows builds require a Windows target and its native SDK." />
    <PrepareWebGpuTask HeaderDirectory="$(MSBuildProjectDirectory)/../Sia.WebGPU.Generators/Resources"
                       ArtifactsDirectory="$(NativeArtifactsDirectory)" ReleaseTag="$(WebGpuRelease)"
                       RuntimeIdentifier="$(RuntimeIdentifier)" OutputDirectory="$(NativeOutputDirectory)">
      <Output TaskParameter="SdkRoot" PropertyName="NativeSdkRoot" />
      <Output TaskParameter="SourceRoot" PropertyName="NativeSourceRoot" />
      <Output TaskParameter="Revision" PropertyName="NativeRevision" />
    </PrepareWebGpuTask>
    <GenerateNativeExportsTask Header="$(NativeSdkRoot)/include/dawn/webgpu.h"
                               OutputDirectory="$(NativeIntermediateDirectory)" />
    <ItemGroup>
      <NativeSource Include="$(NativeSourceRoot)/src/dawn/common/DynamicLib.cpp"
                    Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeSource Include="$(NativeIntermediateDirectory)/NativeExports.cpp" />
      <NativeIncludeDirectory Include="$(NativeSdkRoot)/include" />
      <NativeIncludeDirectory Include="$(NativeSourceRoot);$(NativeSourceRoot)/src/dawn/partition_alloc"
                              Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeCompileOption Include="/DDAWN_FORCE_SYSTEM_COMPONENT_LOAD;/DDAWN_HAVE_UTILS_BUILD_CONFIG;/DNDEBUG"
                           Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeLibrary Include="$(NativeSdkRoot)/lib/webgpu_dawn.lib" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeLibrary Include="$(NativeSdkRoot)/lib*/libwebgpu_dawn.a"
                     Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeCompileOption Include="/O2"
                           Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Release'" />
      <NativeCompileOption Include="-O2"
                           Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Release'" />
      <NativeCompileOption Include="/Zi"
                           Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Debug'" />
      <NativeCompileOption Include="-g"
                           Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Debug'" />
      <NativeLinkOption Include="/DEBUG"
                        Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Debug'" />
    </ItemGroup>
  </Target>

  <Target Name="Build" DependsOnTargets="PrepareNative">
    <NativeBuildTask Sources="@(NativeSource)" RuntimeIdentifier="$(RuntimeIdentifier)"
                     OutputFile="$(NativeOutputFile)" IntermediateDirectory="$(NativeIntermediateDirectory)"
                     Toolchain="$(NativeToolchain)" Compiler="$(NativeCompiler)"
                     WindowsSdkRoot="$(NativeWindowsSdkRoot)" IncludeDirectories="@(NativeIncludeDirectory)"
                     Libraries="@(NativeLibrary)" CompileOptions="@(NativeCompileOption)"
                     LinkOptions="@(NativeLinkOption)" DefinitionFile="$(NativeIntermediateDirectory)/Native.def"
                     MaxParallelism="$(NativeMaxParallelism)" />
    <WriteLinesToFile File="$(NativeOutputDirectory)/native-release.txt" Lines="$(NativeRevision)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="Clean">
    <ItemGroup>
      <_NativeCache Include="$(NativeIntermediateDirectory)/*.obj;$(NativeIntermediateDirectory)/*.o;
                             $(NativeIntermediateDirectory)/*.inputs;$(NativeIntermediateDirectory)/*.d;
                             $(NativeIntermediateDirectory)/*.pdb" />
    </ItemGroup>
    <Delete Files="@(_NativeCache);$(NativeOutputFile);$(NativeOutputFile).inputs;
                   $(NativeOutputDirectory)/$([System.IO.Path]::GetFileNameWithoutExtension('$(NativeOutputFile)')).pdb" />
  </Target>

  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
</Project>
