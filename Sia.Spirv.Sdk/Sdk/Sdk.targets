<Project>
  <PropertyGroup>
    <EnableSpirvCompilation Condition="'$(EnableSpirvCompilation)' == ''">true</EnableSpirvCompilation>
    <SpirvTargetEnvironment Condition="'$(SpirvTargetEnvironment)' == ''">vulkan1.2</SpirvTargetEnvironment>
    <SpirvKernelAbi Condition="'$(SpirvKernelAbi)' == ''">webgpu</SpirvKernelAbi>
    <SpirvEmitWgsl Condition="'$(SpirvEmitWgsl)' == ''">true</SpirvEmitWgsl>
    <SpirvOptimizationLevel Condition="'$(SpirvOptimizationLevel)' == ''">2</SpirvOptimizationLevel>
    <SpirvCompilerToolPath Condition="'$(SpirvCompilerToolPath)' == ''">$(MSBuildThisFileDirectory)..\tools\net11.0\Sia.Spirv.Tool.dll</SpirvCompilerToolPath>
    <SpirvBrowserPolyfillDirectory Condition="'$(SpirvBrowserPolyfillDirectory)' == ''">$(MSBuildThisFileDirectory)..\tools\browser</SpirvBrowserPolyfillDirectory>
    <SpirvDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</SpirvDotNetHost>
    <SpirvDotNetHost Condition="'$(SpirvDotNetHost)' == ''">dotnet</SpirvDotNetHost>
    <_SiaSpirvSdkPackageDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_SiaSpirvSdkPackageDirectory>
    <SpirvToolchainPackageVersion Condition="'$(SpirvToolchainPackageVersion)' == ''">$([System.IO.Path]::GetFileName('$(_SiaSpirvSdkPackageDirectory)'))</SpirvToolchainPackageVersion>
    <SpirvHostRuntimeIdentifier Condition="'$(SpirvHostRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</SpirvHostRuntimeIdentifier>
    <SpirvToolExecutableSuffix Condition="$([MSBuild]::IsOSPlatform('Windows'))">.exe</SpirvToolExecutableSuffix>
    <_SiaSpirvToolchainPackageId>Sia.Spirv.Toolchain.$(SpirvHostRuntimeIdentifier)</_SiaSpirvToolchainPackageId>
    <_SiaSpirvWorkloadToolchainDirectory Condition="'$(NetCoreRoot)' != ''">$(NetCoreRoot)packs/$(_SiaSpirvToolchainPackageId)/$(SpirvToolchainPackageVersion)/tools/$(SpirvHostRuntimeIdentifier)</_SiaSpirvWorkloadToolchainDirectory>
    <SpirvToolchainDirectory Condition="'$(SpirvToolchainDirectory)' == '' and Exists('$(_SiaSpirvWorkloadToolchainDirectory)/llc$(SpirvToolExecutableSuffix)')">$(_SiaSpirvWorkloadToolchainDirectory)</SpirvToolchainDirectory>
    <_SpirvToolchainArgument Condition="'$(SpirvToolchainDirectory)' != ''"> --toolchain &quot;$(SpirvToolchainDirectory)&quot;</_SpirvToolchainArgument>
    <_SpirvWgslArgument Condition="'$(SpirvEmitWgsl)' == 'true'"> --emit-wgsl</_SpirvWgslArgument>
    <_SpirvPassesArgument Condition="'$(SpirvPassesFile)' != ''"> --passes-json &quot;$(SpirvPassesFile)&quot;</_SpirvPassesArgument>
    <_SpirvTargetProfileArgument Condition="'$(SpirvTargetProfileFile)' != ''"> --target-profile-json &quot;$(SpirvTargetProfileFile)&quot;</_SpirvTargetProfileArgument>
    <_SpirvVariantsArgument Condition="'$(SpirvVariantsFile)' != ''"> --variants-json &quot;$(SpirvVariantsFile)&quot;</_SpirvVariantsArgument>
  </PropertyGroup>

  <Target Name="CompileSiaSpirvKernels"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(EnableSpirvCompilation)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <SpirvOutputDirectory Condition="'$(SpirvOutputDirectory)' == ''">$(TargetDir)spirv</SpirvOutputDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(SpirvCompilerToolPath)')"
           Text="The Sia SPIR-V compiler was not found at '$(SpirvCompilerToolPath)'." />
    <Error Condition="'$(SpirvToolchainDirectory)' == '' or !Exists('$(SpirvToolchainDirectory)/llc$(SpirvToolExecutableSuffix)')"
           Text="The prebuilt Sia SPIR-V host toolchain was not found. Install the spirv-tools workload or reference $(_SiaSpirvToolchainPackageId)." />
    <Error Condition="!Exists('$(SpirvToolchainDirectory)/spirv-val$(SpirvToolExecutableSuffix)')"
           Text="The SPIR-V validator was not found under '$(SpirvToolchainDirectory)'." />
    <Error Condition="'$(SpirvPassesFile)' != '' and !Exists('$(SpirvPassesFile)')"
           Text="The SPIR-V pass configuration was not found at '$(SpirvPassesFile)'." />
    <Error Condition="'$(SpirvTargetProfileFile)' != '' and !Exists('$(SpirvTargetProfileFile)')"
           Text="The SPIR-V target profile was not found at '$(SpirvTargetProfileFile)'." />
    <Error Condition="'$(SpirvVariantsFile)' != '' and '$(SpirvTargetProfileFile)' != ''"
           Text="SpirvVariantsFile and SpirvTargetProfileFile cannot be combined." />
    <Error Condition="'$(SpirvVariantsFile)' != '' and !Exists('$(SpirvVariantsFile)')"
           Text="The SPIR-V variant configuration was not found at '$(SpirvVariantsFile)'." />
    <MakeDir Directories="$(SpirvOutputDirectory)" />
    <Exec Command="&quot;$(SpirvDotNetHost)&quot; &quot;$(SpirvCompilerToolPath)&quot; compile --assembly &quot;$(TargetPath)&quot; --output &quot;$(SpirvOutputDirectory)&quot; --target $(SpirvTargetEnvironment) --abi $(SpirvKernelAbi) --optimization $(SpirvOptimizationLevel)$(_SpirvWgslArgument)$(_SpirvToolchainArgument)$(_SpirvPassesArgument)$(_SpirvTargetProfileArgument)$(_SpirvVariantsArgument)" />
    <ItemGroup>
      <FileWrites Include="$(SpirvOutputDirectory)\**\*" />
    </ItemGroup>
  </Target>

  <Target Name="PublishSiaSpirvArtifacts"
          AfterTargets="Publish"
          DependsOnTargets="CompileSiaSpirvKernels"
          Condition="'$(EnableSpirvCompilation)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Error
        Condition="'$(TargetPlatformIdentifier)' == 'browser' and !Exists('$(SpirvBrowserPolyfillDirectory)\_framework\dotnet.js')"
        Text="The browser shader compiler was not found at '$(SpirvBrowserPolyfillDirectory)\_framework\dotnet.js'. Install or update the spirv-tools workload." />
    <Error
        Condition="'$(TargetPlatformIdentifier)' == 'browser' and !Exists('$(SpirvBrowserPolyfillDirectory)\sia-spirv-polyfill.js')"
        Text="The browser SPIR-V polyfill loader was not found at '$(SpirvBrowserPolyfillDirectory)\sia-spirv-polyfill.js'. Install or update the spirv-tools workload." />
    <ItemGroup>
      <_SiaSpirvPublishArtifact Remove="@(_SiaSpirvPublishArtifact)" />
      <_SiaSpirvPublishFile Remove="@(_SiaSpirvPublishFile)" />
    </ItemGroup>
    <ReadLinesFromFile File="$(SpirvOutputDirectory)\spirv-artifacts.txt"
                       Condition="Exists('$(SpirvOutputDirectory)\spirv-artifacts.txt')">
      <Output TaskParameter="Lines" ItemName="_SiaSpirvPublishFile" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_SiaSpirvPublishArtifact Include="$(SpirvOutputDirectory)\**\*"
                                Condition="!Exists('$(SpirvOutputDirectory)\spirv-artifacts.txt')" />
      <_SiaSpirvPublishArtifact Include="@(_SiaSpirvPublishFile->'$(SpirvOutputDirectory)/%(Identity)')">
        <DestinationPath>%(_SiaSpirvPublishFile.Identity)</DestinationPath>
      </_SiaSpirvPublishArtifact>
      <_SiaSpirvPublishArtifact
          Include="$(SpirvBrowserPolyfillDirectory)\**\*"
          Condition="'$(TargetPlatformIdentifier)' == 'browser'" />
      <_SiaSpirvPublishArtifact Update="@(_SiaSpirvPublishArtifact)"
                                Condition="'%(_SiaSpirvPublishArtifact.DestinationPath)' == ''">
        <DestinationPath>%(_SiaSpirvPublishArtifact.RecursiveDir)%(_SiaSpirvPublishArtifact.Filename)%(_SiaSpirvPublishArtifact.Extension)</DestinationPath>
      </_SiaSpirvPublishArtifact>
    </ItemGroup>
    <PropertyGroup>
      <_SiaSpirvPublishDirectory>$(PublishDir)spirv</_SiaSpirvPublishDirectory>
      <_SiaSpirvPublishDirectory Condition="'$(TargetPlatformIdentifier)' == 'browser'">$(PublishDir)wwwroot\spirv</_SiaSpirvPublishDirectory>
    </PropertyGroup>
    <Copy SourceFiles="@(_SiaSpirvPublishArtifact)"
          DestinationFiles="@(_SiaSpirvPublishArtifact->'$(_SiaSpirvPublishDirectory)\%(DestinationPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Import Project="Sdk.targets"
          Sdk="Microsoft.NET.Sdk"
          Condition="'$(SiaSpirvSkipMicrosoftNetSdkTargetsImport)' != 'true'" />
</Project>
