<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.Spirv.Toolchain.win-x64</PackageId>
    <PackageDescription>Prebuilt LLVM 23, SPIRV-Tools, and Naga host toolchain for Windows x64.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <None Include="ToolchainManifest.json" Pack="true" PackagePath="metadata" />
    <None Include="Sdk\**\*" Pack="true" PackagePath="Sdk" />
    <None Include="buildTransitive\**\*" Pack="true" PackagePath="buildTransitive" />
    <None Include="..\artifacts\llvm-toolchain\bin\*.exe"
          Pack="true"
          PackagePath="tools\win-x64" />
    <None Include="..\artifacts\llvm-toolchain\bin\sia_spirv_naga.dll"
          Pack="true"
          PackagePath="tools\win-x64" />
    <None Include="..\artifacts\llvm-toolchain\licenses\*.txt"
          Pack="true"
          PackagePath="licenses" />
    <None Include="..\artifacts\llvm-toolchain\include\sia_spirv_naga.h"
          Pack="true"
          PackagePath="tools\win-x64\include" />
    <_RequiredSpirvTool Include="llc.exe;opt.exe;llvm-as.exe;llvm-dis.exe;naga.exe;sia_spirv_naga.dll;spirv-as.exe;spirv-dis.exe;spirv-link.exe;spirv-opt.exe;spirv-val.exe" />
    <_RequiredSpirvLicense Include="LLVM.txt;Naga.txt;SPIRV-Tools.txt;SPIRV-Headers.txt" />
    <_RequiredSpirvHeader Include="sia_spirv_naga.h" />
  </ItemGroup>

  <Target Name="ValidateSpirvToolchainPackInputs" BeforeTargets="Pack">
    <Error Condition="!Exists('..\artifacts\llvm-toolchain\bin\%(_RequiredSpirvTool.Identity)')"
           Text="Required prebuilt tool '%(_RequiredSpirvTool.Identity)' was not found. Build the native toolchain first." />
    <Error Condition="!Exists('..\artifacts\llvm-toolchain\licenses\%(_RequiredSpirvLicense.Identity)')"
           Text="Required native license '%(_RequiredSpirvLicense.Identity)' was not staged. Build the native toolchain first." />
    <Error Condition="!Exists('..\artifacts\llvm-toolchain\include\%(_RequiredSpirvHeader.Identity)')"
           Text="Required native header '%(_RequiredSpirvHeader.Identity)' was not staged. Build the native toolchain first." />
  </Target>
</Project>
