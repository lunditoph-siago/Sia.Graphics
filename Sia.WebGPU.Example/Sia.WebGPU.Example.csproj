<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <EnableSpirvCompilation>true</EnableSpirvCompilation>
    <SpirvTargetEnvironment>vulkan1.2</SpirvTargetEnvironment>
    <SpirvKernelAbi>webgpu</SpirvKernelAbi>
    <SpirvEmitWgsl>true</SpirvEmitWgsl>
    <SpirvOptimizationLevel>3</SpirvOptimizationLevel>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj_browser\**" />
    <EmbeddedResource Remove="obj_browser\**" />
    <None Remove="obj_browser\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sia.Graphics\Sia.Graphics.csproj" />
    <ProjectReference Include="..\Sia.Spirv.Core\Sia.Spirv.Core.csproj" />
    <ProjectReference Include="..\Sia.WebGPU\Sia.WebGPU.csproj" />
    <ProjectReference Include="..\Sia.WebGPU.Native\Sia.WebGPU.Native.csproj" />
    <PackageReference Include="Sia.GLFW" Version="0.0.1" />
    <PackageReference Include="Sia.GLFW.Native" Version="0.0.1" />
    <PackageReference Include="Sia.Math" Version="0.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\*.ttf">
      <LogicalName>Sia.WebGPU.Example.Fonts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="RemoveBundledSpirvCoreReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="Sia.Spirv.Core" />
    </ItemGroup>
  </Target>
</Project>
