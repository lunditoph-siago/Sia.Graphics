<Project>
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <NativeArtifactsDirectory Condition="'$(NativeArtifactsDirectory)' == ''">$(MSBuildProjectDirectory)/../artifacts/webgpu</NativeArtifactsDirectory>
    <NativeSdkRoot>$(NativeArtifactsDirectory)/$(NativeReleaseTag)/native-$(RuntimeIdentifier)</NativeSdkRoot>
    <NativeIntermediateDirectory Condition="'$(NativeIntermediateDirectory)' == ''">$(MSBuildProjectDirectory)/obj/native/$(RuntimeIdentifier)/$(Configuration)</NativeIntermediateDirectory>
    <NativeOutputDirectory Condition="'$(NativeOutputDirectory)' == ''">$(MSBuildProjectDirectory)/runtimes/$(RuntimeIdentifier)/native</NativeOutputDirectory>
    <NativeOutputFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(NativeOutputDirectory)/wgpu_native.dll</NativeOutputFile>
    <NativeOutputFile Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(NativeOutputDirectory)/libwgpu_native.so</NativeOutputFile>
    <NativeOutputFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(NativeOutputDirectory)/libwgpu_native.dylib</NativeOutputFile>
    <NativePowerShell Condition="$([MSBuild]::IsOSPlatform('Windows'))">powershell.exe</NativePowerShell>
    <NativePowerShell Condition="'$(NativePowerShell)' == ''">pwsh</NativePowerShell>
    <NativeMaxParallelism Condition="'$(NativeMaxParallelism)' == ''">2</NativeMaxParallelism>
  </PropertyGroup>
  <UsingTask TaskName="NativeBuildTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task><Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)NativeBuildTask.cs" /></Task>
  </UsingTask>
  <Target Name="PrepareNative">
    <Error Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' != '$(NETCoreSdkRuntimeIdentifier)'" Text="This native target requires a matching host SDK/toolchain; cross-platform builds do not automatically cross-compile." />
    <Error Condition="$([MSBuild]::IsOSPlatform('Windows')) And !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" Text="Windows builds require a Windows target and its native SDK." />
    <Exec IgnoreStandardErrorWarningFormat="true" Command="$(NativePowerShell) -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/PrepareNative.ps1&quot; -RuntimeIdentifier $(RuntimeIdentifier) -ArtifactsDirectory &quot;$(NativeArtifactsDirectory)&quot; -OutputDirectory &quot;$([System.IO.Path]::GetFullPath('$(NativeOutputDirectory)/../..'))&quot;" />
    <Exec Command="$(NativePowerShell) -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/GenerateExports.ps1&quot; -Header &quot;$(NativeSdkRoot)/include/dawn/webgpu.h&quot; -OutputDirectory &quot;$(NativeIntermediateDirectory)&quot;" />
    <ItemGroup>
      <NativeSource Include="$(NativeArtifactsDirectory)/$(NativeReleaseTag)/source/src/dawn/common/DynamicLib.cpp" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeSource Include="$(NativeIntermediateDirectory)/NativeExports.cpp" />
      <NativeIncludeDirectory Include="$(NativeSdkRoot)/include" />
      <NativeIncludeDirectory Include="$(NativeArtifactsDirectory)/$(NativeReleaseTag)/source;$(NativeArtifactsDirectory)/$(NativeReleaseTag)/source/src/dawn/partition_alloc" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeCompileOption Include="/DDAWN_FORCE_SYSTEM_COMPONENT_LOAD;/DDAWN_HAVE_UTILS_BUILD_CONFIG;/DNDEBUG" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeLibrary Include="$(NativeSdkRoot)/lib/webgpu_dawn.lib" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeLibrary Include="$(NativeSdkRoot)/lib*/libwebgpu_dawn.a" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeCompileOption Include="/O2" Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Release'" />
      <NativeCompileOption Include="-O2" Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Release'" />
      <NativeCompileOption Include="/Zi" Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Debug'" />
      <NativeCompileOption Include="-g" Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Debug'" />
      <NativeLinkOption Include="/DEBUG" Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(Configuration)' == 'Debug'" />
    </ItemGroup>
  </Target>
  <Target Name="Build" DependsOnTargets="PrepareNative">
    <NativeBuildTask Sources="@(NativeSource)" RuntimeIdentifier="$(RuntimeIdentifier)"
                     OutputFile="$(NativeOutputFile)" IntermediateDirectory="$(NativeIntermediateDirectory)"
                     Toolchain="$(NativeToolchain)" Compiler="$(NativeCompiler)" WindowsSdkRoot="$(NativeWindowsSdkRoot)"
                     IncludeDirectories="@(NativeIncludeDirectory)" Libraries="@(NativeLibrary)"
                     CompileOptions="@(NativeCompileOption)" LinkOptions="@(NativeLinkOption)"
                     DefinitionFile="$(NativeIntermediateDirectory)/Native.def" MaxParallelism="$(NativeMaxParallelism)" />
    <WriteLinesToFile File="$(NativeOutputDirectory)/native-release.txt" Lines="$(NativeReleaseTag)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="Clean">
    <ItemGroup><_NativeCache Include="$(NativeIntermediateDirectory)/*.obj;$(NativeIntermediateDirectory)/*.o;$(NativeIntermediateDirectory)/*.inputs;$(NativeIntermediateDirectory)/*.d;$(NativeIntermediateDirectory)/*.pdb" /></ItemGroup>
    <Delete Files="@(_NativeCache);$(NativeOutputFile);$(NativeOutputFile).inputs;$(NativeOutputDirectory)/$([System.IO.Path]::GetFileNameWithoutExtension('$(NativeOutputFile)')).pdb" />
  </Target>
  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
</Project>
