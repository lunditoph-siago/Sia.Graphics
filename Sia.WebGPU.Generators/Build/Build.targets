<Project>
  <Import Project="..\..\WebGPU.props" />

  <ItemGroup>
    <Compile Remove="Build\**\*.cs" />
  </ItemGroup>

  <UsingTask TaskName="ResolveWebGpuHeaderTask" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)ResolveWebGpuHeaderTask.cs" />
    </Task>
  </UsingTask>
  <UsingTask TaskName="DownloadWebGpuHeaderTask" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)DownloadWebGpuHeaderTask.cs" />
    </Task>
  </UsingTask>

  <Target Name="SyncWebGpuHeader" BeforeTargets="BeforeBuild">
    <ResolveWebGpuHeaderTask ReleaseTag="$(WebGpuRelease)">
      <Output TaskParameter="HeaderUrl" PropertyName="_GeneratorWebGpuHeaderUrl" />
      <Output TaskParameter="Revision" PropertyName="_GeneratorWebGpuHeaderRevision" />
    </ResolveWebGpuHeaderTask>
    <DownloadWebGpuHeaderTask HeaderUrl="$(_GeneratorWebGpuHeaderUrl)"
        OutputFile="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)\Resources\webgpu.h'))" />
    <Message Importance="Normal" Text="WebGPU header $(WebGpuRelease): $(_GeneratorWebGpuHeaderRevision)" />
  </Target>
</Project>
