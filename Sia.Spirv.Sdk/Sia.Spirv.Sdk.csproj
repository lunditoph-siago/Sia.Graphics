<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Sia.Spirv.Sdk</PackageId>
    <PackageVersion>0.1.0-preview.1</PackageVersion>
    <Description>MSBuild SDK for compiling C# GPU kernels to SPIR-V with LLVM.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sia.Spirv.Tool\Sia.Spirv.Tool.csproj"
                      ReferenceOutputAssembly="false" />
    <None Include="Sdk\**\*" Pack="true" PackagePath="Sdk" />
    <None Include="..\Sia.Spirv.Tool\bin\$(Configuration)\net10.0\**\*"
          Pack="true"
          PackagePath="tools\net10.0" />
    <None Include="..\artifacts\llvm-toolchain\bin\*.exe"
          Pack="true"
          PackagePath="tools\win-x64" />
  </ItemGroup>

  <Target Name="ValidateSpirvPackInputs" BeforeTargets="Pack">
    <Error Condition="!Exists('..\artifacts\llvm-toolchain\bin\llc.exe')"
           Text="Build the LLVM SPIR-V toolchain before packing Sia.Spirv.Sdk." />
    <Error Condition="!Exists('..\artifacts\llvm-toolchain\bin\spirv-val.exe')"
           Text="Build SPIRV-Tools before packing Sia.Spirv.Sdk." />
  </Target>
</Project>
