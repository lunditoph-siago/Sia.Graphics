<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.WebGPU</PackageId>
    <PackageDescription>Generated WebGPU bindings with first-class Sia ECS resource integration.</PackageDescription>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sia.RenderGraph\Sia.RenderGraph.csproj" />
    <ProjectReference Include="..\Sia.Spirv.Compiler\Sia.Spirv.Compiler.csproj" />
    <ProjectReference Include="..\Sia.WebGPU.Generators\Sia.WebGPU.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <PackageReference Include="Sia" Version="2.1.6" />
  </ItemGroup>
  <Target Name="GenerateWebGpuPackageTargets" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_WebGpuPackageTargets>$(IntermediateOutputPath)Sia.WebGPU.targets</_WebGpuPackageTargets>
      <_WebGpuPackageContent><![CDATA[<Project><PropertyGroup><EmccFlags>%24(EmccFlags) --use-port=emdawnwebgpu</EmccFlags></PropertyGroup><ItemGroup><_WasmPInvokeModules Include="__Internal_emscripten" /></ItemGroup></Project>]]></_WebGpuPackageContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_WebGpuPackageTargets)" Lines="$(_WebGpuPackageContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><None Include="$(_WebGpuPackageTargets)" Pack="true" PackagePath="buildTransitive/Sia.WebGPU.targets" /></ItemGroup>
  </Target>
</Project>
