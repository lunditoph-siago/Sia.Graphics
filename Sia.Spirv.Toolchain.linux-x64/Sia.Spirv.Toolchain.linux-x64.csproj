<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <PackageId>Sia.Spirv.Toolchain.linux-x64</PackageId>
    <PackageDescription>Prebuilt LLVM 23 and SPIRV-Tools host toolchain for Linux x64.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <_RequiredSpirvTool Include="llc;opt;llvm-as;llvm-dis;spirv-as;spirv-dis;spirv-link;spirv-opt;spirv-val" />
    <_RequiredSpirvLicense Include="LLVM.txt;SPIRV-Tools.txt;SPIRV-Headers.txt" />
    <None Include="ToolchainManifest.json" Pack="true" PackagePath="metadata" />
    <None Include="Sdk\**\*" Pack="true" PackagePath="Sdk" />
    <None Include="buildTransitive\**\*" Pack="true" PackagePath="buildTransitive" />
    <None Include="@(_RequiredSpirvTool->'..\artifacts\llvm-toolchain-linux-x64\bin\%(Identity)')"
          Pack="true"
          PackagePath="tools\linux-x64" />
    <None Include="@(_RequiredSpirvLicense->'..\artifacts\llvm-toolchain-linux-x64\licenses\%(Identity)')"
          Pack="true"
          PackagePath="licenses" />
  </ItemGroup>

  <Target Name="ValidateSpirvToolchainPackInputs" BeforeTargets="Pack">
    <Error Condition="!Exists('..\artifacts\llvm-toolchain-linux-x64\bin\%(_RequiredSpirvTool.Identity)')"
           Text="Required prebuilt tool '%(_RequiredSpirvTool.Identity)' was not found. Build the native toolchain first." />
    <Error Condition="!Exists('..\artifacts\llvm-toolchain-linux-x64\licenses\%(_RequiredSpirvLicense.Identity)')"
           Text="Required native license '%(_RequiredSpirvLicense.Identity)' was not staged. Build the native toolchain first." />
  </Target>
</Project>
